<?xml version="1.0" encoding="utf-8"?>
<Profile xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <Id>b4382594-5a21-4f17-8a4b-2d7c04192b01</Id>
  <Name>TMC - The Multipurpose Companion</Name>
  <Commands>
    <Command>
      <Id>b4382594-5a21-4f17-8a4b-2d7c04192b11</Id>
      <CommandString>¿Estado de la nave?;Estado de la nave;Informe de nave;Ship status</CommandString>
      <Description>Consulta el estado general del casco, escudos y depósitos</Description>
      <Category>TMC Cabina</Category>
      <ActionSequence>
        <CommandAction>
          <ActionType>Launch</ActionType>
          <Path>powershell.exe</Path>
          <Args>-WindowStyle Hidden -NoProfile -Command "Invoke-RestMethod -Uri 'http://127.0.0.1:47320/api/voice/intent' -Method Post -ContentType 'application/json' -Body '{\"query\":\"ShipStatus\"}'"</Args>
          <Async>true</Async>
        </CommandAction>
      </ActionSequence>
      <Async>true</Async>
      <Enabled>true</Enabled>
    </Command>
    <Command>
      <Id>b4382594-5a21-4f17-8a4b-2d7c04192b12</Id>
