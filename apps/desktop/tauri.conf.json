{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TMC",
  "mainBinaryName": "TMC",
  "version": "0.1.0",
  "identifier": "io.github.danikuso.tmc",
  "build": {
    "frontendDist": "http://127.0.0.1:47320",
    "beforeBuildCommand": {
      "script": "npm --prefix ../../ui run build",
      "cwd": "."
    }
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "languages": [
          "Spanish",
          "English",
          "French",
          "German",
          "Portuguese"
        ]
      }
    }
  }
}
